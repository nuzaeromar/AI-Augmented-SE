# Orchestral AI - API Keys Configuration
# Copy this file to .env and add your API keys

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT
OPENAI_API_KEY=sk-proj-...

# Google Gemini
GOOGLE_API_KEY=AIza...

# Groq
GROQ_API_KEY=gsk_...

# Mistral AI
MISTRAL_API_KEY=...

# AWS Bedrock (requires AWS credentials configured separately)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Note: At least one API key is required
# Ollama models run locally and don't need API keys
